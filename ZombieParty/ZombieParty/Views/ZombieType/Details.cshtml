@model ZombieTypeVM
@{
    ViewData["Title"] = "Details";
}

<h1>Type: @Model.ZombieType.TypeName</h1>
@{
    List<Zombie> zombiesList = new();
    foreach (var item in Model.ZombiesList)
    {

        if (item.ZombieTypeId == Model.ZombieType.Id)
        {
            zombiesList.Add(item);
        }
    }
    <h3>Nombre de zombies: @zombiesList.Count</h3>
    <h3>Moyenne de points: @zombiesList.Average(z => z.Point)</h3>
    // Manière plus simple?
}
<div class="row">
    @foreach (var item in Model.ZombiesList)
    {
        <div href="#" class="card  border m-3 text-center bg-warning" style="width: 20rem; background-image: url('/images/imagesLayout/Fond.png'); ">
            <div class="card-body  text-warning">
                <h3 class="card-title"> @item.Name </h3>
                <h5> @item.Point </h5>
            </div>
        </div>
    }

</div>

@if (Model.ZombiesList.Count == 0)
{
    <div class="alert alert-danger">No associated zombie for this type</div>
}

<div>
    <a asp-action="Index">Back to List</a>
</div>

